# Sincronización con Supabase.
#
# Copiá este archivo como `.env.local` y completá los dos valores. Sin ellos la
# app funciona igual, pero solo contra IndexedDB en este dispositivo.
#
# Los encontrás en: Supabase → tu proyecto → Project Settings → API Keys.
#
# La clave publicable es de lectura/escritura PERO está protegida por RLS: solo
# devuelve las filas del usuario que inició sesión. Por eso puede viajar en el
# navegador. Nunca pongas acá la `service_role`: esa se saltea RLS entera.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
